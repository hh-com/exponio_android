<?xml version="1.0" encoding="utf-8"?>
<!--
  Keine Cloud-Backups und kein Geräte-Transfer: Zugangsdaten sind an den Android-Keystore
  dieses Geräts gebunden und wären auf einem anderen Gerät ohnehin nicht entschlüsselbar.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
